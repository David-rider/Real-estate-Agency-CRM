# Variables for the local development stack (docker-compose.yml in the repo root).
# 本地开发环境（根目录 docker-compose.yml）用的变量。
# Copy to .env (git-ignored) and fill in the two required values. Never use these values in production.
# 复制成 .env（已被 git 忽略），填好两个必填项。不要把这些值用在生产环境。

# Required: any local-only value. Generate one with: openssl rand -hex 24
DEV_DB_PASSWORD=""
# Required: at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=""

# Optional / 可选
# DEV_DB_USER=crm
# DEV_DB_NAME=crm_dev
# DEV_DB_PORT=5432
# DEV_API_PORT=4000
# DEV_WEB_PORT=3000
# DISABLE_JOBS=false
