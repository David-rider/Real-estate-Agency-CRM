# Variables for the local development stack (docker-compose.yml at the repo root).
# Copy to .env (git-ignored) and fill in the required values. Never use these values in production.

# Required: any local-only value. Generate one with: openssl rand -hex 24
DEV_DB_PASSWORD=""
# Required: at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=""

# Optional
# DEV_DB_USER=inmo
# DEV_DB_NAME=inmo_dev
# DEV_DB_PORT=5432
# DEV_API_PORT=4000
# DEV_WEB_PORT=3000
# DISABLE_JOBS=false
