# ── Required ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/real_estate_crm"
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ── Email Service ─────────────────────────────────────────
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="Your Brokerage"

# ── Stripe Payments ───────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_ANNUAL=""

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Apple Sign In ─────────────────────────────────────────
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ── File Storage (Cloudflare R2 or AWS S3) ────────────────
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── AI assistant (in development — off by default) ────────
# Set AI_ASSISTANT_ENABLED=true and an API key to turn it on.
# While off, listing copy uses the built-in templates.
AI_ASSISTANT_ENABLED="false"
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"   # override the default model if needed

# ── Operations (optional) ─────────────────────────────────
# TRUST_PROXY=1          # proxies in front of the API (defaults to 1 in production)
# DISABLE_JOBS=true      # turn off the in-process appointment-reminder job

# ── DocuSign ──────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_PRIVATE_KEY=""
DOCUSIGN_BASE_URL="https://na4.docusign.net"

# ── Sentry ────────────────────────────────────────────────
SENTRY_DSN=""
