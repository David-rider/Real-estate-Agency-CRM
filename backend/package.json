{
  "name": "backend",
  "version": "1.1.0",
  "appVersion": "1.1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "npx prisma generate",
    "start": "npx ts-node --transpile-only src/server.ts",
    "start:compiled": "node dist/server.js",
    "compile": "tsc --skipLibCheck",
    "postinstall": "npx prisma generate",
    "test": "npm run test:smoke",
    "test:smoke": "ts-node --transpile-only tests/smoke.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "typecheck": "tsc --skipLibCheck --noEmit",
    "release": "ts-node --transpile-only src/release.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@prisma/client": "^4.16.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "prisma": "^4.16.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/csv-parse": "^1.1.12",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
