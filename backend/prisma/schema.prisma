// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Organization {
  id                String   @id @default(uuid())
  name              String
  subscription      SubTier  @default(BASIC)
  preferredLanguage String   @default("en")
  website           String?
  address           String?
  phone             String?
  licenseNumber     String?
  logoUrl           String?
  // Public web address of the brokerage's listings page: /public-listings?b=<slug>
  slug              String?  @unique
  // Commission defaults applied when a deal closes (percent values, e.g. 3 = 3%)
  defaultCommissionRate Float @default(3)
  defaultFirmSplit      Float @default(30)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users          User[]
  clients        Client[]
  properties     Property[]
  transactions   Transaction[]
  commissions    Commission[]
  offers         Offer[]
  documents      Document[]
  appointments   Appointment[]
  mediaAssets    MediaAsset[]
  marketingTasks MarketingTask[]
  referrals      Referral[]
  giftOrders     GiftOrder[]
  tasks          Task[]
  notes          Note[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
}

enum SubTier {
  BASIC
  PRO
  ENTERPRISE
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  password          String?
  googleId          String?      @unique
  appleId           String?      @unique
  name              String
  role              Role         @default(AGENT)
  tier              Tier         @default(CORE)
  preferredLanguage String       @default("en")
  orgId             String
  organization      Organization @relation(fields: [orgId], references: [id])

  // Profile fields
  avatarUrl     String?
  phone         String?
  title         String?
  licenseNumber String?
  linkedIn      String?
  bio           String?
  timezone      String   @default("America/New_York")

  // Auth fields
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  emailVerifyToken    String?
  emailVerified       Boolean  @default(false)
  isActive            Boolean  @default(true)
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients        Client[]
  properties     Property[]
  transactions   Transaction[]
  commissions    Commission[]
  offers         Offer[]
  appointments   Appointment[]
  marketingTasks MarketingTask[]
  referralsGiven Referral[]      @relation("Referrer")
  referralsRecv  Referral[]      @relation("Referee")
  giftOrders     GiftOrder[]
  tasks          Task[]
  notes          Note[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

enum Role {
  SUPERADMIN
  FIRMADMIN
  MANAGER
  AGENT
  ATTORNEY
  LENDER
  TITLECO
  MARKETING
  OFFICE_SUPPORT
}

enum Tier {
  CORE
  PRO
  ELITE
}

// ─── Client ──────────────────────────────────────────────────────────────────

model Client {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  type           ClientType   @default(BUYER)
  status         ClientStatus @default(ACTIVE)
  funnelStage    ClientFunnel @default(LEAD)

  // Extended fields
  source              String?   // Referral, Zillow, StreetEasy, Website, etc.
  tags                String?   // Comma-separated tags
  notes               String?   // Quick notes field
  budget              String?
  targetMoveDate      DateTime?
  lastContactedAt     DateTime?
  preferredContact    String?   // email | phone | text | any
  referredBy          String?   // free-text referrer name
  coAgentId           String?   // co-agent on same client
  temperature         String?   @default("WARM") // HOT | WARM | COLD — lead priority

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions Transaction[]
  offers       Offer[]
  appointments Appointment[]
  giftOrders   GiftOrder[]
  clientNotes  Note[]
}

enum ClientType {
  BUYER
  SELLER
  REFERRAL
  RENTER
  INVESTOR
}

enum ClientStatus {
  LEAD
  ACTIVE
  IN_CONTRACT
  CLOSED
  ARCHIVED
}

enum ClientFunnel {
  LEAD
  QUALIFIED
  SHOWING
  OFFERING
  IN_CONTRACT
  CLOSED
  ARCHIVED
}

// ─── Property ────────────────────────────────────────────────────────────────

model Property {
  id          String     @id @default(uuid())
  address     String
  city        String
  state       String
  zip         String
  price       Float
  beds        Float
  baths       Float
  sqft        Int?
  description String?
  status      PropStatus @default(ACTIVE)

  // Extended fields
  propertyType    String?   // CONDO | COOP | TOWNHOUSE | SINGLE_FAMILY | MULTI_FAMILY | COMMERCIAL | LAND
  neighborhood    String?
  yearBuilt       Int?
  mlsNumber       String?
  hoaFee          Float?
  parkingSpaces   Int?
  virtualTourUrl  String?
  featuredImage   String?
  featured        Boolean  @default(false)
  listingDate     DateTime?
  expirationDate  DateTime?
  daysOnMarket    Int?

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions  Transaction[]
  offers        Offer[]
  appointments  Appointment[]
  mediaAssets   MediaAsset[]
  propertyNotes Note[]
}

enum PropStatus {
  COMING_SOON
  ACTIVE
  IN_CONTRACT
  SOLD
  WITHDRAWN
  EXPIRED
}

// ─── Transaction ─────────────────────────────────────────────────────────────

model Transaction {
  id         String      @id @default(uuid())
  propertyId String
  property   Property    @relation(fields: [propertyId], references: [id])
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  agentId    String
  agent      User        @relation(fields: [agentId], references: [id])
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  price      Float
  status     TransStatus @default(OFFER_REVIEW)

  // Timeline fields
  acceptedPrice     Float?
  contractDate      DateTime?
  inspectionDate    DateTime?
  boardPackageDate  DateTime?
  clearToCloseDate  DateTime?
  closingDate       DateTime?
  contingencies     String?   // comma-separated: FINANCING, INSPECTION, APPRAISAL, SALE_OF_HOME
  notes             String?
  coAgentId         String?   // co-broker agent
  commissionRate    Float?    // percent of sale price; falls back to org default

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions       Commission[]
  documents         Document[]
  transactionNotes  Note[]
}

enum TransStatus {
  OFFER_REVIEW
  IN_CONTRACT
  BOARD_PACKAGE
  CLEARED_TO_CLOSE
  CLOSED
  FALLEN_THROUGH
}

// ─── Commission ──────────────────────────────────────────────────────────────

model Commission {
  id               String      @id @default(uuid())
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id])
  agentId          String
  agent            User        @relation(fields: [agentId], references: [id])
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id])
  grossAmount      Float
  firmSplitPercent Float
  overridePercent  Float
  netPayout        Float
  status           CommStatus  @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum CommStatus {
  PENDING
  REQUESTED
  PAID
  DISPUTED
}

// ─── Offer ───────────────────────────────────────────────────────────────────

model Offer {
  id           String      @id @default(uuid())
  amount       Float
  status       OfferStatus @default(PENDING)
  notes        String?
  expiresAt    DateTime?
  counterAmount Float?
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id])
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  agentId      String
  agent        User        @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER
  WITHDRAWN
  EXPIRED
}

// ─── Document ────────────────────────────────────────────────────────────────

model Document {
  id            String      @id @default(uuid())
  name          String
  url           String
  type          String      // CONTRACT | INSPECTION | APPRAISAL | BOARD_PACKAGE | ID | DISCLOSURE | OTHER
  sizeBytes     Int?
  mimeType      String?
  version       Int         @default(1)
  signatureRequired Boolean @default(false)
  signedAt      DateTime?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  uploadedById  String?
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id     String        @id @default(uuid())
  title  String
  date   DateTime
  endDate DateTime?
  notes  String?
  status AppointStatus @default(SCHEDULED)
  type   ApptType      @default(MEETING)

  // Extended fields
  durationMin       Int?     @default(60)
  location          String?
  virtualLink       String?
  confirmationSent  Boolean  @default(false)
  reminderSent      Boolean  @default(false)
  colorCode         String?

  agentId      String
  agent        User          @relation(fields: [agentId], references: [id])
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id])
  propertyId   String?
  property     Property?     @relation(fields: [propertyId], references: [id])
  orgId        String
  organization Organization  @relation(fields: [orgId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum AppointStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum ApptType {
  SHOWING
  MEETING
  CALL
  OPEN_HOUSE
  INSPECTION
  CLOSING
  FOLLOW_UP
}

// ─── MediaAsset ──────────────────────────────────────────────────────────────

model MediaAsset {
  id         String   @id @default(uuid())
  url        String
  type       String   // image | video | floorplan | 3d_tour
  caption    String?
  sortOrder  Int      @default(0)
  sizeBytes  Int?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  orgId      String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── MarketingTask ───────────────────────────────────────────────────────────

model MarketingTask {
  id           String       @id @default(uuid())
  title        String
  content      String?
  status       String       @default("PENDING")  // PENDING | IN_PROGRESS | PUBLISHED | ARCHIVED
  channel      String?      // email | instagram | facebook | linkedin | twitter
  scheduledAt  DateTime?
  publishedAt  DateTime?
  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Referral ────────────────────────────────────────────────────────────────

model Referral {
  id           String       @id @default(uuid())
  referrerId   String
  referrer     User         @relation("Referrer", fields: [referrerId], references: [id])
  refereeId    String
  referee      User         @relation("Referee", fields: [refereeId], references: [id])
  status       String       @default("PENDING")  // PENDING | ACCEPTED | PAID
  feeAmount    Float?
  notes        String?
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── GiftOrder ───────────────────────────────────────────────────────────────

model GiftOrder {
  id           String       @id @default(uuid())
  item         String
  status       String       @default("ORDERED")  // ORDERED | SHIPPED | DELIVERED | CANCELLED
  amount       Float?
  trackingNum  String?
  deliveredAt  DateTime?
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Task (Agent To-Do) ───────────────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  // Linked entities (all optional)
  linkedClientId      String?
  linkedPropertyId    String?
  linkedTransactionId String?

  agentId      String
  agent        User         @relation(fields: [agentId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Note ────────────────────────────────────────────────────────────────────

model Note {
  id      String @id @default(uuid())
  content String
  type    String @default("NOTE")  // NOTE | CALL | EMAIL | MEETING | SHOWING | SYSTEM

  // Linked to one of these (all optional, at least one expected)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  propertyId    String?
  property      Property?    @relation(fields: [propertyId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotifType
  title     String
  message   String
  readAt    DateTime?
  link      String?          // deep-link path e.g. /crm/123
  metadata  String?          // JSON blob for extra context

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

enum NotifType {
  NEW_CLIENT
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  APPOINTMENT_REMINDER
  TRANSACTION_UPDATE
  COMMISSION_PAID
  TASK_DUE
  DOCUMENT_SIGNED
  SYSTEM
}

// ─── Invitation ──────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(uuid())
  email       String
  role        String    @default("AGENT")
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE_CLIENT, UPDATE_ROLE, DELETE_PROPERTY, etc.
  entity    String   // Client | User | Property | Transaction | etc.
  entityId  String?
  before    String?  // JSON snapshot before change
  after     String?  // JSON snapshot after change
  ipAddress String?
  userAgent String?

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}
